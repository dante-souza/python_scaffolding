# Data: keep directory structure, ignore contents by default
/data/raw/*
!/data/raw/.gitkeep
/data/interim/*
!/data/interim/.gitkeep
/data/processed/*
!/data/processed/.gitkeep
# Reference data may be intentionally versioned; do not blanket-ignore it.
